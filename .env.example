# J.A.R.V.I.S. Environment Configuration

# Get your Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Mode settings (optional: active, passive)
INITIAL_MODE=passive

# Voice Settings (optional: male, female)
VOICE_GENDER=male
VOICE_RATE=180
VOICE_VOLUME=1.0
